{
  "version": 2,
  "builds": [
    {
      "src": "api/gate.js",
      "use": "@vercel/node",
      "config": { "includeFiles": ["assets/ledger.html"] }
    },
    { "src": "api/setup.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/setup", "dest": "/api/setup.js" },
    { "src": "/.*", "dest": "/api/gate.js" }
  ]
}
